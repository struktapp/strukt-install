{
    "name": "strukt/install",
    "description": "Strukt Framework Installer",
    "keywords": ["strukt"],
    "license": "MIT",
    "authors": [
        {
            "name": "Samuel Weru",
            "email": "pitsolu@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.2",
        "strukt/console": "v2.0.0",
        "strukt/process": "v2.0.0"
    },
    "bin": [
        "bin/strukt"
    ],
    "autoload": {
        "psr-4": {
            "Strukt\\": "src/Strukt/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "lint": "php -l bin/strukt && php -l src/Strukt/Installer/DevInstaller.php && for f in src/Strukt/Installer/Command/*.php tests/*.php; do php -l \"$f\" || exit 1; done",
        "test": "php tests/DevInstallerTest.php"
    }
}
